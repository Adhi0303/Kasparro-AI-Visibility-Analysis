APP_ENV=development
DATABASE_URL=sqlite:///./kasparro.db
EXECUTION_MODE=replay

ANALYST_TOKEN=dev-analyst-token-2026
REVIEWER_TOKEN=dev-reviewer-token-2026

# OpenAI-compatible provider configuration.
# Gemini example (Google AI Studio):
# EXECUTION_MODE=real_model
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# LLM_API_KEY=replace-with-your-local-gemini-key
#
# Keep EXECUTION_MODE=replay until you are ready to make a live provider call.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

